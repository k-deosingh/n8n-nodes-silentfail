{
  "name": "n8n-nodes-silentfail",
  "version": "0.3.0",
  "description": "Tell Silent Fail your workflow finished, so you get an email when it stops",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "silentfail",
    "monitoring",
    "heartbeat",
    "dead man's switch",
    "cron monitoring"
  ],
  "license": "MIT",
  "homepage": "https://silentfailapp.com",
  "author": {
    "name": "Silent Fail",
    "email": "contact@silentfailapp.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k-deosingh/n8n-nodes-silentfail.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "prepublishOnly": "n8n-node build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/SilentFailMonitorApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SilentFail/SilentFail.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "n8n-workflow": "*"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
